__pycache__/
*.pyc
*.pyo
.env
.venv/
venv/
*.egg-info/
build/
dist/
# 运行期自动生成的数据文件
data/metrics.json
data/handoffs/
data/state/*.json
data/state/submissions.jsonl
data/arbitration/
# M9 并发锁文件
data/state/*.lock
data/state/*.tmp
data/state/*.owner.json
# 运行期内容归档目录
data/state/content/
# SLIB 会话绑定运行期数据
data/bindings/
# context validate 跨进程层A基线（运行期比对数据，不入库）
data/state/context_baseline/
# 变更感知测试结果缓存（可放 cache: 卷持久化，不入库）
.testcache/
# 变更感知瞬时计划落盘（立即 rm；异常残留不入库）
.ca-plan.json
# 实库（M11.3）：SQLite 文件由 scripts/build_role_db.py 从 data/ 重建，
# 重建是确定性的、秒级，所以库里那份「二进制」不进版本库 —— 进库只会变成
# 每次改画像都要提交一个 .db 的二进制 diff，评审看不见、冲突解不了。
# 产物形态（DDL / 数据字典）进库，随时可 rebuild。
data/db/*.db
data/db/*.db-journal

# M11 导出产物（industry export / gen_data_inventory 生成）
# 与 data/db/*.db 同一条道理：数据可由 yaml 秒级重建，把 1.6 MB 生成 SQL 和
# 一份 sqlite 二进制提交进 git 只会得到看不见的 diff + 解不了的冲突。
# 进库的是**结构**（data/db/industry/*.sql）与**盘存清单**
# （docs/industry/data-inventory.md），产物随时可 rebuild。
out/
